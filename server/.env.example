# NEXUS AI server — copy to .env and fill in. NEVER commit .env. Server-side only:
# none of these values may be exposed to client/ or admin/ (they only get VITE_API_BASE_URL).

NODE_ENV=development
PORT=4001
API_PREFIX=/api/v1
# LOG_LEVEL=info

# --- Supabase (Project settings → API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler connection string (transaction mode, port 6543). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:URL-ENCODED-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_POOL_MAX=8
DB_STATEMENT_TIMEOUT_MS=30000

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Must produce 1536-dimension vectors (the database column is vector(1536)).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=900

# --- Frontend origins (CORS allowlist; invitation links use CLIENT_URL) ---
CLIENT_URL=http://localhost:5187
ADMIN_URL=http://localhost:5188
# Comma-separated additional origins (e.g. production domains)
EXTRA_CORS_ORIGINS=

# --- Limits and cost controls ---
STORAGE_BUCKET=ai_knowledge_chat_documents
MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=500
MAX_SOURCE_CHARACTERS=2000000
MAX_CONTEXT_CHUNKS=8
MAX_HISTORY_MESSAGES=6
RETRIEVAL_MIN_SIMILARITY=0.3
# default number of videos to index when a channel is added (the admin can choose 1-500 per channel)
CHANNEL_MAX_VIDEOS=50
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_MAX_REQUESTS=10
INVITATION_EXPIRY_HOURS=168

# --- Background processing worker ---
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
JOB_STALE_MINUTES=15

# Set to true when running behind a reverse proxy (Railway, Render, Nginx) so rate limits see the real client IP.
TRUST_PROXY=false

# --- Outgoing email (invitations, password resets, notices) ---
# Gmail: enable 2-step verification, create an App Password (Google Account > Security > App passwords).
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=NEXUS AI
# MAIL_FROM_EMAIL=   (defaults to SMTP_USER)
# MAIL_REPLY_TO=
# Recipients on these domains are never emailed (used by tests)
MAIL_SKIP_DOMAINS=example.test,example.com,example.org,example.net,test,invalid,localhost
